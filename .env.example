# Copy to .env (repository root) and fill in. Never commit .env.

# PostgreSQL on Neon (P0-03). SQLAlchemy URL with the psycopg driver; Neon requires SSL.
DATABASE_URL=

# A second, separate Neon database (or branch) used only by DB tests; it is wiped by the X1 reset.
TEST_DATABASE_URL=

# Local Ollama, OpenAI-compatible endpoint, and the default model (DECISIONS.md).
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3.5:4b

# Sales Agent: shared secret that Planning sends in the X-Planning-Key header when it answers (door 3). Leave empty to refuse all.
SALES_PLANNING_KEY=

# Background work runner (event dispatcher, ...). Set to false to start the API without background threads.
BACKGROUND_WORKERS=true
# Simulator write doors (factory settings): value of the X-Door-Key header. Leave empty to refuse all.
SIMULATION_DOOR_KEY=
