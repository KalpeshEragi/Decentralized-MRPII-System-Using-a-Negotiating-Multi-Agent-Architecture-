# Copy to .env (repository root) and fill in. Never commit .env.

# PostgreSQL on Neon (P0-03). SQLAlchemy URL with the psycopg driver; Neon requires SSL.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Local Ollama, OpenAI-compatible endpoint, and the default model (DECISIONS.md).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:4b
